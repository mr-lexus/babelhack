{
  "name": "babelhack",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "playwright test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check": "npm run build && npm test && npm run test:rust",
    "build:windows": "tauri build --bundles nsis",
    "format": "prettier --write src tests scripts playwright.config.ts vite.config.ts package.json tsconfig.json index.html",
    "format:check": "prettier --check src tests scripts playwright.config.ts vite.config.ts package.json tsconfig.json index.html",
    "test:native": "node scripts/smoke-native.mjs",
    "build:desktop": "tauri build",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "prettier": "^3.9.9",
    "typescript": "^5.5.4",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "license": "Apache-2.0"
}
